{
  "info": {
    "name": "Shopify AI Bridge",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Search Products",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/search-products", "host": ["http://localhost:3000"], "path": ["api", "search-products"] },
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"protein\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Get Product Details",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/product", "host": ["http://localhost:3000"], "path": ["api", "product"] },
        "body": { "mode": "raw", "raw": "{\n  \"product_id\": \"1234567890\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/create-order", "host": ["http://localhost:3000"], "path": ["api", "create-order"] },
        "body": { "mode": "raw", "raw": "{\n  \"customer\": {\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"+11234567890\"\n  },\n  \"shipping_address\": {\n    \"address1\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"province\": \"NY\",\n    \"country\": \"US\",\n    \"zip\": \"10001\"\n  },\n  \"items\": [\n    {\n      \"variant_id\": \"9876543210\",\n      \"quantity\": 1\n    }\n  ],\n  \"payment_method\": \"COD\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Order Status",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/order-status", "host": ["http://localhost:3000"], "path": ["api", "order-status"] },
        "body": { "mode": "raw", "raw": "{\n  \"order_number\": \"#1001\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Get Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/customer", "host": ["http://localhost:3000"], "path": ["api", "customer"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\"\n}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "Get Store Info",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{API_SECRET}}" }
        ],
        "url": { "raw": "http://localhost:3000/api/store-info", "host": ["http://localhost:3000"], "path": ["api", "store-info"] }
      }
    }
  ]
}
